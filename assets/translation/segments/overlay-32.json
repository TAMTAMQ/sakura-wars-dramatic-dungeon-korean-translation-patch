      "note": ""
    },
    {
      "id": "arm9-overlay:32@00000FFC",
      "locator": {
        "offset": 4092
      },
      "source_text": "ジャンヌは、星組たちの",
      "source_hex": "835783838393836b82cd814190af916782bd82bf82cc",
      "korean_text": "잔느는 성조의",
      "apply_translation": true,
      "review_status": "cross_review_required",
      "note": ""
    },
    {
      "id": "arm9-overlay:32@00001014",
      "locator": {
        "offset": 4116
      },
      "source_text": "思いをわかってくれたのに……",
      "source_hex": "8e7682a282f082ed82a982c182c482ad82ea82bd82cc82c981638163",
      "korean_text": "마음을 알아줬는데……",
