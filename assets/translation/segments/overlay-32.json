      "note": ""
    },
    {
      "id": "arm9-overlay:32@0000106C",
      "locator": {
        "offset": 4204
      },
      "source_text": "思いをわかってくれたわ……",
      "source_hex": "8e7682a282f082ed82a982c182c482ad82ea82bd82ed81638163",
      "korean_text": "마음을 알아줬어……",
      "apply_translation": true,
      "review_status": "cross_review_required",
      "note": ""
    },
    {
      "id": "arm9-overlay:32@00001088",
      "locator": {
        "offset": 4232
      },
      "source_text": "それがわからないんですか!?",
