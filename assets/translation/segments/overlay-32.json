      "note": ""
    },
    {
      "id": "arm9-overlay:32@000010D4",
      "locator": {
        "offset": 4308
      },
      "source_text": "なんだと……？",
      "source_hex": "82c882f182be82c6816381638148",
      "korean_text": "뭐라고……?",
